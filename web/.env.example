# Copia este archivo con el nombre .env.local (en esta misma carpeta, web/)
# y reemplaza los valores con los de tu proyecto de Supabase:
# Supabase → tu proyecto → Project Settings → API Keys / Data API.
#
# La "publishable key" está hecha para usarse en el navegador.
# NUNCA pongas aquí la "secret key" ni la "service_role key".
# .env.local nunca se sube a Git.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
